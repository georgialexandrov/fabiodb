{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fabio",
  "version": "0.3.0",
  "identifier": "dev.alexandrov.fabio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fabio",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 400,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "\u00a9 2026 Georgi Alexandrov. MIT OR Apache-2.0.",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
